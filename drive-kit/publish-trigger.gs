/**
 * Nonfiction Hotlist: publish trigger.
 *
 * Every 10 minutes, checks whether any sheet, doc or image in each site's Drive kit was edited, and if
 * so asks GitHub to publish that site: the Hotlist (every year's kit) and the website. Once an hour it
 * also asks the Hotlist for a refresh so the dashboards' numbers stay current. GitHub's own schedule
 * only runs every few hours on this account, so this is what makes edits show up within about 15 minutes.
 *
 * Setup (once):
 *   1. GitHub > Settings > Developer settings > Fine-grained tokens > Generate new token.
 *      Resource owner: Nonfiction-Hotlist. Repository access: only Nonfiction-Hotlist/list and Nonfiction-Hotlist/website. Permissions: Actions, Read and write.
 *   2. Here in Apps Script: Project Settings (gear) > Script properties > Add property
 *      GITHUB_TOKEN = the token.
 *   3. Choose install in the function menu and click Run. Approve the permissions.
 * To stop it: run uninstall.
 *
 * Generated by scripts/content/build-kit.js in the list repo. When a kit is added (a new year, or the
 * website), paste the new version over this one and run install again.
 */

// Each site: its repo, the "Site manifest (do not edit)" sheet of each of its kits, and whether its
// dashboards want an hourly refresh.
const SITES = [
  {
    "name": "the Hotlist",
    "repo": "Nonfiction-Hotlist/list",
    "manifests": {
      "2025": "17uYuyEQBr9vkaEFm_vUv_aCpC-0pkcsJIFhR2ss4KCc",
      "2026": "1hgplff1yg7_Ijr8eNwOEGbhRnjhoJXpwKTo_7LicvgA"
    },
    "refresh": true
  },
  {
    "name": "the website",
    "repo": "Nonfiction-Hotlist/website",
    "manifests": {
      "website": "1Ob7tXbw4f4U5JmfPGdxrKKLj1FYZgXin7NlRGbTbwj4"
    },
    "refresh": false
  }
];
const REFRESH_EVERY_MS = 60 * 60 * 1000;

function install() {
  uninstall();
  ScriptApp.newTrigger("check").timeBased().everyMinutes(10).create();
  const props = PropertiesService.getScriptProperties();
  SITES.forEach(site => {
    props.setProperty("lastSeen:" + site.repo, String(newestEdit_(site)));
    publish_(site, "sync");
  });
  Logger.log(`Installed. Checking ${SITES.map(s => s.name).join(" and ")} every 10 minutes.`);
}

function uninstall() {
  ScriptApp.getProjectTriggers().filter(t => t.getHandlerFunction() === "check").forEach(t => ScriptApp.deleteTrigger(t));
}

function check() {
  const props = PropertiesService.getScriptProperties();
  SITES.forEach(site => {
    const lastSeen = Number(props.getProperty("lastSeen:" + site.repo) || 0);
    const lastRefresh = Number(props.getProperty("lastRefresh:" + site.repo) || 0);
    const newest = newestEdit_(site);
    if (newest > lastSeen) {
      if (publish_(site, "sync")) props.setProperty("lastSeen:" + site.repo, String(newest));
    } else if (site.refresh && Date.now() - lastRefresh > REFRESH_EVERY_MS) {
      publish_(site, "sync");
    }
  });
}

// Latest edit time across every file a site reads (each listed in its kits' Site manifests).
function newestEdit_(site) {
  let rows = [];
  Object.entries(site.manifests).forEach(([kit, id]) => {
    try { rows = rows.concat(SpreadsheetApp.openById(id).getSheets()[0].getDataRange().getValues().slice(1)); }
    catch (e) { Logger.log(`Can't read the ${kit} manifest: ${e}`); }
  });
  let newest = 0;
  rows.forEach(r => {
    const id = String(r[3] || "").trim();
    if (!id) return;
    try { newest = Math.max(newest, DriveApp.getFileById(id).getLastUpdated().getTime()); } catch (e) { Logger.log("Can't read " + id + ": " + e); }
  });
  return newest;
}

function publish_(site, mode) {
  const token = PropertiesService.getScriptProperties().getProperty("GITHUB_TOKEN");
  if (!token) throw new Error("Add the GITHUB_TOKEN script property first (see the setup notes at the top).");
  const res = UrlFetchApp.fetch(`https://api.github.com/repos/${site.repo}/actions/workflows/publish.yml/dispatches`, {
    method: "post",
    contentType: "application/json",
    headers: { Authorization: "Bearer " + token, Accept: "application/vnd.github+json", "X-GitHub-Api-Version": "2022-11-28" },
    payload: JSON.stringify({ ref: "main", inputs: { mode } }),
    muteHttpExceptions: true
  });
  const ok = res.getResponseCode() === 204;
  if (ok) PropertiesService.getScriptProperties().setProperty("lastRefresh:" + site.repo, String(Date.now()));
  else Logger.log(`GitHub said ${res.getResponseCode()} for ${site.repo}: ${res.getContentText().slice(0, 300)}`);
  return ok;
}
